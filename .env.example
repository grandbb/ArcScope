# Required
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Arc Mainnet (chain ID 5042; native USDC uses 18 decimals)
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
# Optional provider WebSocket URL; leave empty to poll blocks over HTTP.
NEXT_PUBLIC_ARC_WS_URL=

# Optional (higher market-data rate limits)
NEXT_PUBLIC_COINGECKO_API_KEY=your_coingecko_api_key
